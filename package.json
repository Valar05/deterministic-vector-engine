{
  "name": "deterministic-vector-engine-wonder",
  "private": true,
  "type": "module",
  "scripts": {
    "test:wonder": "node --test tests/wonder-apprenticeship.test.mjs",
    "wonder:intake": "python tools/wonder_source_intake.py verify",
    "wonder:render": "node tools/render_wonder_gate.mjs",
    "test:wonder:corpus": "python -m unittest discover -s tests -p test_wonder_corpus.py",
    "wonder:corpus:legacy": "python tools/build_wonder_corpus.py build --max-dim 360 && python tools/induce_wonder_grammar.py",
    "wonder:sparse": "node tools/build_relation_study.mjs && node tools/render_sparse_shovel.mjs",
    "test:wonder:sparse": "node --test tests/sparse-line-study.test.mjs",
    "test:wonder:finish": "node --test tests/sparse-line-study.test.mjs && python -m unittest tests.test_sparse_server",
    "wonder:relations": "npm run wonder:correspondence",
    "wonder:correspondence": "node tools/build_relation_study.mjs"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4"
  }
}
