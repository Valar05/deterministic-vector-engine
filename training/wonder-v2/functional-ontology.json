  "families": {
    "force-transfer": {
      "proposition": "Cultivate the force-transmission body while retaining rigid tool, grip, and reaction interfaces.",
      "preserve": [
        "direction of work",
        "operator interface",
        "terminal tool geometry"
      ],
      "propagate": [
        "actuator volume",
        "housing",
        "reaction path",
        "service access"
      ]
    },
    "containment": {
      "proposition": "Cultivate a tensioned containment membrane inside standardized edges, closures, and lifting interfaces.",
      "preserve": [
        "usable volume",
        "closure",
        "handling interface"
      ],
      "propagate": [
        "frame spacing",
        "puncture protection",
        "inspection access",
        "replacement seams"
      ]
    },
    "support-logistics": {
      "proposition": "Cultivate the load or service column while retaining exact height, mobility, and attachment interfaces.",
      "preserve": [
        "working elevation",
        "wheel contact",
        "tool interface"
      ],
      "propagate": [
        "column section",
        "base spread",
        "nutrient routing",
        "maintenance clearance"
      ]
    },
    "compliant-support": {
      "proposition": "Cultivate distributed compliance where human load enters the object while preserving stable manufactured support geometry.",
      "preserve": [
        "human scale",
        "ground stability",
        "safe posture"
      ],
      "propagate": [
        "load surface depth",
        "restraint spacing",
        "replacement access",
        "frame geometry"
      ]
    },
    "pressure-containment": {
      "proposition": "Cultivate the pressure vessel and let its swelling reorganize restraint, seams, inspection, and rupture containment.",
      "preserve": [
        "port standard",
        "pressure job",
        "service envelope"
      ],
      "propagate": [
        "cage geometry",
        "flange placement",
        "safety volume",
        "failure direction"
      ]
    },
    "flow": {
      "proposition": "Cultivate flow handling before payload, keeping hard ports and control interfaces while vascular geometry changes the housing.",
      "preserve": [
        "port location",
        "flow direction",
        "control affordance"
      ],
      "propagate": [
        "manifold spacing",
        "restraint rhythm",
        "heat or pressure clearance",
        "inspection access"
      ]
    }
  }
}
